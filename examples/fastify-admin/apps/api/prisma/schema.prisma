generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AccessRequest {
  id             String        @id @default(uuid()) @db.Uuid
  requesterName  String        @map("requester_name") @db.VarChar(120)
  requesterEmail String        @map("requester_email") @db.VarChar(254)
  systemName     String        @map("system_name") @db.VarChar(120)
  reason         String        @db.VarChar(1000)
  status         RequestStatus @default(PENDING)
  reviewerNote   String?       @map("reviewer_note") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int           @default(1)

  @@index([status, updatedAt])
  @@map("access_requests")
}
